# Copy this file to .env and fill in your key to enable real AI in the
# Agent Workspace's "Analyse with AI" and "Generate draft" actions.
# Without this set, those actions fall back to the built-in scripted
# simulation (client/src/lib/simulatedAI.ts) automatically.
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
